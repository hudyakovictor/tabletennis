{
  "name": "topspin-arena",
  "private": true,
  "scripts": {
    "build": "node tt/tools/render_rules_table.cjs && python3 tt/build.py",
    "docs:rules": "node tt/tools/render_rules_table.cjs",
    "docs:check": "node tt/tools/render_rules_table.cjs --check",
    "test": "node --test tests/*.test.js",
    "test:audit": "node --test tests/return-serve-audit.test.js",
    "coverage:return-serve": "c8 --reporter=text --reporter=json --reports-dir=test-results/coverage-return-serve node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "test:diagnostics": "node tests/diagnostics-browser.cjs",
    "test:missshots": "node tests/missshots-browser.cjs",
    "relay": "node tt/server.js",
    "calibrate": "node tt/tools/calibrate.cjs",
    "noise": "node tt/tools/noise_zone_sim.cjs",
    "ai:serves": "node tt/tools/ai_serve_map.cjs",
    "analyze:log": "node tt/tools/analyze_input_log.cjs",
    "bench:log": "node tt/tools/benchmark_input_log.cjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^138.0.2",
    "c8": "^10.1.3",
    "puppeteer-core": "^24.25.0"
  }
}
