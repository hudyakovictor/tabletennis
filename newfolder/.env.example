# ============================================================================
# TOPSPIN ARENA — Admin CRM Environment Configuration
# ============================================================================

PORT=4100
HOST=0.0.0.0
NODE_ENV=development

# Database (Embedded SQLite on single RF server at start; PostgreSQL ready)
CRM_DB_PATH=./data/crm.sqlite
PRIMARY_DATA_REGION=RU

# Admin Owner Bootstrap Credentials
ADMIN_EMAIL=owner@topspin.arena
ADMIN_PASSWORD=TopspinAdmin2026!
SESSION_SECRET=change-me-in-production-64-bytes-random-hex
PII_HASH_SALT=change-me-in-production-152fz-salt

# CORS & Security
ADMIN_ALLOWED_ORIGINS=http://localhost:4100
# Whitelist for the game client (`/api/client/v1/*`). Comma-separated, exact
# origins. localhost/127.0.0.1 are always allowed outside production, so a dev
# bundle on any port works; everything else must be listed here.
CLIENT_ALLOWED_ORIGINS=https://tabletennis-indexhtml.vercel.app
CRM_STRICT_FRAME_GUARD=false

# Telegram Mini App Auth Verification (Game Bot Token)
TELEGRAM_GAME_BOT_TOKEN=

# Read-Only Admin Telegram Bot (Second Channel: Push Alerts + Pull Commands)
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ============================================================================
# Isolated AI Providers per Zone (No shared AI Router at launch — 07-ai-providers.md)
# Supported providers: local_statistical | openrouter | nvidia | yandexgpt | gigachat | ollama
# ============================================================================

# Zone Ops (Fast small model, 100k tokens/day cap)
ZONE_OPS_PROVIDER=local_statistical
ZONE_OPS_MODEL=meta-llama/llama-3.1-8b-instruct
ZONE_OPS_API_KEY=
ZONE_OPS_DAILY_TOKEN_LIMIT=100000

# Zone Fraud (Medium model, 200k tokens/day cap)
ZONE_FRAUD_PROVIDER=local_statistical
ZONE_FRAUD_MODEL=qwen/qwen-2.5-72b-instruct
ZONE_FRAUD_API_KEY=
ZONE_FRAUD_DAILY_TOKEN_LIMIT=200000

# Zone Balance (Medium model, 300k tokens/day cap)
ZONE_BALANCE_PROVIDER=local_statistical
ZONE_BALANCE_MODEL=qwen/qwen-2.5-72b-instruct
ZONE_BALANCE_API_KEY=
ZONE_BALANCE_DAILY_TOKEN_LIMIT=300000

# Zone Market (Medium model, 200k tokens/day cap)
ZONE_MARKET_PROVIDER=local_statistical
ZONE_MARKET_MODEL=qwen/qwen-2.5-72b-instruct
ZONE_MARKET_API_KEY=
ZONE_MARKET_DAILY_TOKEN_LIMIT=200000

# Zone Lab (Batch model, 500k tokens/day cap)
ZONE_LAB_PROVIDER=local_statistical
ZONE_LAB_MODEL=deepseek/deepseek-chat
ZONE_LAB_API_KEY=
ZONE_LAB_DAILY_TOKEN_LIMIT=500000

# Director Layer (Reads ONLY zone summaries + 72h chat + state block)
DIRECTOR_PROVIDER=local_statistical
DIRECTOR_MODEL=anthropic/claude-3.5-sonnet
DIRECTOR_API_KEY=
DIRECTOR_DAILY_TOKEN_LIMIT=250000
DIRECTOR_SLIDING_WINDOW_HOURS=72
