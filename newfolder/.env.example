# ─────────────────────────────────────────────────────────────────────────────
# TOPSPIN ARENA CRM — пример конфигурации. Скопируйте в .env и заполните.
# НИКОГДА не коммитьте .env. Все секреты живут только на сервере.
# ─────────────────────────────────────────────────────────────────────────────

# ── Сервер ──────────────────────────────────────────────────────────────────
PORT=4173
HOST=0.0.0.0
CRM_DB_PATH=data/crm.sqlite
CRM_ENV=production
# Часовой пояс для ежедневных сводок/заданий (IANA)
CRM_TIMEZONE=Europe/Moscow
# Демо-данные при первом запуске (1 = включить, 0 = пустая БД)
DEMO_DATA=1
# Размер окна чата директора, часов (48–72 по ТЗ)
DIRECTOR_WINDOW_HOURS=72

# ── Владелец / авторизация ──────────────────────────────────────────────────
ADMIN_USER=owner
# Если не задать — сгенерируется случайный пароль и будет напечатан в лог.
ADMIN_PASSWORD=
# Доп. администраторы: user:password,user2:password2 (пароли в хеш-виде не хранятся в env)
ADMIN_EXTRA_USERS=
# Подпись сессий; обязательно задайте свою в проде.
SESSION_SECRET=
# Ставить ли флаг Secure у cookie (1 для HTTPS, 0 для локального http)
COOKIE_SECURE=0
# Через сколько часов истекает сессия
SESSION_TTL_HOURS=24

# ── CORS / CSP ──────────────────────────────────────────────────────────────
# Разрешённые origin админки (через запятую). Пусто = только same-origin.
ADMIN_ORIGINS=
# Origin игрового клиента для /api/client/* (через запятую). Пусто = без CORS.
CLIENT_ORIGINS=
# CSP frame-ancestors: * для предпросмотра/iframe, 'self' для прода без iframe.
FRAME_ANCESTORS=*

# ── Ingestion: ключи игрового бэкенда ──────────────────────────────────────
# Формат: id:secret,id2:secret2  (secret — случайная строка 32+ символа)
# Пример: INGEST_KEYS=game-prod:xY3....,game-stage:Ab1....
INGEST_KEYS=game-local:dev-secret-change-me-please-32chars
# Максимальный разброс времени подписи, секунд
INGEST_MAX_SKEW_SEC=300
# Максимум событий в одном батче
INGEST_MAX_BATCH=1000

# ── AI-провайдеры: у КАЖДОЙ зоны свой ключ (см. 07-ai-providers.md) ────────
# Общий формат для зоны Z (OPS, FRAUD, BALANCE, MARKET, LAB, DIRECTOR):
#   AI_Z_BASE_URL, AI_Z_API_KEY, AI_Z_MODEL, AI_Z_PRICE_IN, AI_Z_PRICE_OUT
# Если AI_Z_API_KEY пуст — зона работает в локальном детерминированном режиме
# без внешних запросов (данные всё равно анализируются).
AI_OPS_BASE_URL=https://openrouter.ai/api/v1
AI_OPS_API_KEY=
AI_OPS_MODEL=openai/gpt-4o-mini
AI_OPS_PRICE_IN=0.15
AI_OPS_PRICE_OUT=0.60
AI_OPS_DAILY_TOKENS=100000

AI_FRAUD_BASE_URL=https://openrouter.ai/api/v1
AI_FRAUD_API_KEY=
AI_FRAUD_MODEL=openai/gpt-4o-mini
AI_FRAUD_DAILY_TOKENS=200000

AI_BALANCE_BASE_URL=https://openrouter.ai/api/v1
AI_BALANCE_API_KEY=
AI_BALANCE_MODEL=anthropic/claude-3.5-sonnet
AI_BALANCE_DAILY_TOKENS=300000

AI_MARKET_BASE_URL=https://openrouter.ai/api/v1
AI_MARKET_API_KEY=
AI_MARKET_MODEL=openai/gpt-4o-mini
AI_MARKET_DAILY_TOKENS=200000

AI_LAB_BASE_URL=https://integrate.api.nvidia.com/v1
AI_LAB_API_KEY=
AI_LAB_MODEL=meta/llama-3.1-70b-instruct
AI_LAB_DAILY_TOKENS=500000

AI_DIRECTOR_BASE_URL=https://openrouter.ai/api/v1
AI_DIRECTOR_API_KEY=
AI_DIRECTOR_MODEL=anthropic/claude-3.5-sonnet
AI_DIRECTOR_DAILY_TOKENS=200000

# Таймаут одного запроса к провайдеру, мс
AI_TIMEOUT_MS=20000
# Локальный провайдер всегда последний в цепочке fallback.
AI_LOCAL_FALLBACK=1

# ── Telegram-бот (только чтение + пуши) ────────────────────────────────────
BOT_ENABLED=0
BOT_TOKEN=
# ID чатов через запятую (админ, канал алертов). Другие игнорируются.
BOT_CHAT_IDS=
# Час ежедневной сводки (по CRM_TIMEZONE), 0–23
BOT_DAILY_DIGEST_HOUR=9
# Имя команды в боте для подтверждения алерта
BOT_ACK_ENABLED=1

# ── Регионы и резидентность данных (05-legal-rf-sanctions.md) ──────────────
# Карта регион → код storage-зоны (сейчас всё в РФ)
DATA_RESIDENCY_MAP=RU:ru-central1,CIS:ru-central1,EU:ru-central1,IN:ru-central1,BR:ru-central1,US:ru-central1,OTHER:ru-central1
# Эндпоинты игровых серверов по регионам (для /ping и будущего роутинга)
REGION_ENDPOINTS=RU:wss://ru.topspin.example/ws,EU:wss://eu.topspin.example/ws,IN:wss://in.topspin.example/ws,BR:wss://br.topspin.example/ws,US:wss://us.topspin.example/ws
PING_WARN_MS=100

# ── Retention (06-data-schema.md) ───────────────────────────────────────────
RETENTION_INPUT_DAYS=90
RETENTION_TELEMETRY_DAYS=180
RETENTION_AI_DAYS=180
RETENTION_CHAT_DAYS=365

# ── Планировщик ────────────────────────────────────────────────────────────
JOBS_ENABLED=1
ALERTS_EVAL_MINUTES=5
